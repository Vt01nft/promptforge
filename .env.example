# promptforge — environment variables
# copy this file to .env.local and add your keys
# all keys are FREE — see SETUP-GUIDE.md for instructions

# primary: groq (fastest, 14,400 req/day)
# get key at: https://console.groq.com
GROQ_API_KEY=

# fallback 1: qwen 3.5 via dashscope
# get key at: https://dashscope.console.aliyun.com
DASHSCOPE_API_KEY=

# fallback 2: google gemini (500 req/day)
# get key at: https://aistudio.google.com/apikey
GOOGLE_AI_KEY=

# fallback 3: mistral (1B tokens/month)
# get key at: https://console.mistral.ai
MISTRAL_API_KEY=

# fallback 4: openrouter (50 req/day, 30+ free models)
# get key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# at minimum, add ONE key above. groq recommended as primary.
# the app auto-cascades through available providers.
